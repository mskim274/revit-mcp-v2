<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="Contracts/Contracts.csproj" />
    <ProjectReference Include="Engine/Engine.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyEngine" AfterTargets="Build">
    <ItemGroup>
      <EngineFiles Include="$(MSBuildProjectDirectory)/Engine/bin/$(Configuration)/net8.0/AutoCADMCP.ScriptEngine.*" />
      <EngineFiles Include="$(MSBuildProjectDirectory)/Engine/bin/$(Configuration)/net8.0/Microsoft.CodeAnalysis*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(EngineFiles)" DestinationFolder="$(TargetDir)script-engine" />
  </Target>
</Project>
