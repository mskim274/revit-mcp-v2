{
  "name": "@kimminsub/revit-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Autodesk Revit — 32 tools for query, create, modify, view, export, visualization, and scripted operations.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "revit-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "revit",
    "autodesk",
    "bim",
    "claude",
    "anthropic",
    "ai",
    "llm"
  ],
  "author": "mskim274",
  "license": "MIT",
  "homepage": "https://github.com/mskim274/revit-mcp-v2#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mskim274/revit-mcp-v2.git",
    "directory": "server"
  },
  "bugs": {
    "url": "https://github.com/mskim274/revit-mcp-v2/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@kimminsub/mcp-cad-core": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
